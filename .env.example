# Copy to .env and adjust. Runtime settings can also be changed in the UI.

# Comma-separated source paths; defaults point to the bundled archive.
TELEGRAM_EXPORTS=sources/telegram-aqval-alanaam.json,sources/telegram-anarchonomy.json
PDF_SOURCES=sources/weblog-badbakht.pdf

# --- LLM: any OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, OpenAI, OpenRouter, Anthropic, ...) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_TEMPERATURE=0.6

# --- Embeddings (changing the model requires: uv run python -m app.ingest.run --rebuild) ---
EMBED_MODEL=intfloat/multilingual-e5-large
EMBED_DEVICE=cpu            # or cuda
# Rerank fused results with a cross-encoder: better precision, ~1-3 s extra per search on CPU.
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

PERSONA_NAME=Archive Author

# --- Optional web search (turn it on per chat with the Web button; can also be set in the UI) ---
SEARCH_PROVIDER=auto        # auto | tavily | brave | duckduckgo (auto: key prefix tvly- -> Tavily, other key -> Brave, no key -> DuckDuckGo)
SEARCH_API_KEY=

# Share of unfiltered search results reserved for weblog essays (they're ~2% of the documents)
WEBLOG_SHARE=0.3
# Attachments
MAX_UPLOAD_MB=25
MAX_ATTACHMENT_CHARS=60000
